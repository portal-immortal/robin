---
import { Image } from "astro:assets";

interface Props {
  images: any[];
}

const { images } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  {
    images.map((img, index) => (
      <Image
        src={img}
        alt=""
        class={index === 0 ? "md:col-span-2 w-full rounded-xl" : "w-full rounded-xl"}
      />
    ))
  }
</div>